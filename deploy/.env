# =========================================================
# ITR Filing Platform — Docker Compose Environment
# =========================================================

# ======================
# Application
# ======================
APP_NAME=ITR Filing Platform
APP_VERSION=1.0.0
DEBUG=true
API_V1_PREFIX=/api/v1

# ======================
# PostgreSQL
# Service name 'postgres' resolves via Docker internal DNS
# ======================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=itr_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# ======================
# MinIO Object Storage
# Service name 'minio' resolves via Docker internal DNS
# ======================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=itr-documents
MINIO_USE_SSL=false

# Public endpoint for presigned URLs accessed by browsers over LAN.
# Replace with your machine's LAN IP (e.g., 192.168.1.100:9000)
MINIO_PUBLIC_ENDPOINT=192.168.1.107:9000

# ======================
# JWT Authentication
# ======================
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ======================
# Initial Admin Seed User
# ======================
ADMIN_EMAIL=admin@itr-platform.com
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Platform Admin

# ======================
# Dashboard Readonly User
# ======================
DASHBOARD_USER_EMAIL=viewer@itr-platform.com
DASHBOARD_USER_PASSWORD=viewer123

# ======================
# CORS
# Add all origins that need access (comma-separated inside JSON array)
# ======================
CORS_ORIGINS=["http://app.localhost","http://localhost:3000"]

# ======================
# Frontend
# ======================
NEXT_PUBLIC_API_URL=http://api.localhost

# ======================
# Cloudflare Tunnel
# Generate from: https://one.dash.cloudflare.com → Zero Trust → Tunnels
# ======================
CLOUDFLARE_TUNNEL_TOKEN=<YOUR_TUNNEL_TOKEN>

# ======================
# Grafana
# ======================
GRAFANA_ADMIN_PASSWORD=admin

# ======================
# Runtime
# ======================
PYTHONUNBUFFERED=1
TZ=Asia/Kolkata