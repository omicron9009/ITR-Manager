# ============================================================
# ITR Filing Platform — Environment Configuration
# Copy to .env and fill in actual values
# NEVER commit .env to version control
# ============================================================

# Application
APP_NAME=ITR Filing Platform
APP_VERSION=1.0.0
DEBUG=false
API_V1_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=itr_platform
DATABASE_USER=itr_admin
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# MinIO (Object Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_BUCKET_NAME=itr-documents
MINIO_USE_SSL=false

# JWT Authentication
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin seed (created on first startup)
ADMIN_EMAIL=admin@itr-platform.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_FULL_NAME=Platform Admin

# CORS (Frontend URL)
CORS_ORIGINS=["http://localhost:3000","https://itr.example.com"]

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
