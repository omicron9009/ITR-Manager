# ============================================================
# ITR Filing Platform — Environment Configuration
# Copy to .env and fill in actual values
# NEVER commit .env to version control
# ============================================================

# Application
APP_NAME=ITR Filing Platform
APP_VERSION=1.0.0
DEBUG=false
API_V1_PREFIX=/api/v1

# Database (PostgreSQL)
# IMP: keep this localhost for local dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=itr_platform
POSTGRES_USER=itr_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# MinIO (Object Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_BUCKET_NAME=itr-documents
MINIO_USE_SSL=false

# Authentik (Authentication)
AUTHENTIK_BASE_URL=https://auth.example.com
AUTHENTIK_JWKS_URL=https://auth.example.com/application/o/itr-platform/jwks/
AUTHENTIK_ISSUER=https://auth.example.com/application/o/itr-platform/
AUTHENTIK_CLIENT_ID=itr-platform-client-id
AUTHENTIK_AUDIENCE=itr-platform

# CORS (Frontend URL)
CORS_ORIGINS=["http://localhost:3000","https://itr.example.com"]

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
