# =========================================================
# ITR Filing Platform — Dev Docker Compose Environment
# =========================================================

# ======================
# Application
# ======================
APP_NAME=AIकर
APP_VERSION=1.0.0
DEBUG=true
API_V1_PREFIX=/api/v1

# ======================
# PostgreSQL
# Service name 'postgres' resolves via Docker internal DNS
# ======================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=itr_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# ======================
# MinIO Object Storage
# Service name 'minio' resolves via Docker internal DNS
# ======================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=itr-documents
MINIO_USE_SSL=false

# Public endpoint for presigned URLs accessed by browsers.
# In dev this is localhost since MinIO is exposed on port 9000 of the host.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_USE_SSL=false
# MINIO_KMS_SECRET_KEY is intentionally absent — dev MinIO has no KMS configured.
# Setting it would cause put_object to fail with "NotImplemented: KMS not configured".

# ======================
# Redis Cache
# Service name 'redis' resolves via Docker internal DNS
# ======================
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true

# ======================
# JWT Authentication
# ======================
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ======================
# Initial Admin Seed User
# ======================
ADMIN_EMAIL=admin@itr-platform.com
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Platform Admin

# ======================
# Dashboard Readonly User
# ======================
DASHBOARD_USER_EMAIL=viewer@itr-platform.com
DASHBOARD_USER_PASSWORD=viewer123

# ======================
# CORS
# ======================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ======================
# Frontend (Next.js)
# Must be reachable from the browser, not the docker network
# ======================
NEXT_PUBLIC_API_URL=http://localhost:8000

# ======================
# WhatsApp / OpenWA Gateway
# openwa-api resolves via Docker internal DNS
# ======================
# Master key passed to the OpenWA container — backend uses it once on startup
# to auto-create a per-app API key (set any strong random string here)
WHATSAPP_OPENWA_MASTER_KEY=change-me-strong-random-master-key
WHATSAPP_DEFAULT_BASE_URL=http://openwa-api:2785
WHATSAPP_DEFAULT_SESSION_NAME=itr-platform
# Fernet key for encrypting the per-app API key at rest (32 url-safe base64 bytes)
WHATSAPP_ENCRYPTION_KEY=CHANGE-ME-WHATSAPP-FERNET-KEY-32B

# ======================
# Runtime
# ======================
PYTHONUNBUFFERED=1
TZ=Asia/Kolkata
