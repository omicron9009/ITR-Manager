APP_NAME=ITR Filing Platform
APP_VERSION=1.0.0
DEBUG=true
API_V1_PREFIX=/api/v1

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=itr_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=itr-documents
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_USE_SSL=false

JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

ADMIN_EMAIL=admin@itr-platform.com
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Platform Admin

DASHBOARD_USER_EMAIL=viewer@itr-platform.com
DASHBOARD_USER_PASSWORD=viewer123

CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

WHATSAPP_ENCRYPTION_KEY=CHANGE-ME-WITH-A-VALID-FERNET-KEY
WHATSAPP_OPENWA_MASTER_KEY=change-me-openwa-master-key

GRAFANA_ADMIN_PASSWORD=admin
PYTHONUNBUFFERED=1
TZ=Asia/Kolkata
